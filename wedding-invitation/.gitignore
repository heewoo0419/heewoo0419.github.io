# 이 폴더에서 바로 작업하고 커밋합니다.
# 아래는 로컬에만 두는 것들 — 배포에는 필요 없거나 올리면 안 되는 파일입니다.

# 원본 사진 (240MB) — 웹용으로 줄인 photos/*.jpg 만 배포합니다.
# 표지·카드 그림을 다시 뽑아야 하면 photos/originals/cover2.jpeg 에서 만듭니다.
assets/photos/originals/

# 폰트 원본 — 상용 폰트라 저장소에 올리지 않습니다.
# 표지 SVG 다시 생성에만 사용합니다.
assets/fonts/*.ttf
assets/fonts/*.otf
assets/fonts/unused/

# 브랜드 원본 에셋
assets/*.zip
assets/toss-logo/

# 작업용 문서 — 실명·연락처·계좌가 들어 있어 공개 저장소에 올리지 않습니다.
docs/

# 편집기·도구 설정
.claude/
.idea/
.vscode/
__pycache__/
*.py[cod]

.DS_Store
